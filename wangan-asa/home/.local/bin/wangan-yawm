#!/usr/bin/env bash
# Taskwarrior popups for the waybar "yawm" module, same frames as the
# launcher (window rules wangan-yawm / wangan-yawm-add in hypr/wangan-asa.lua).
#   wangan-yawm        task list  (click)
#   wangan-yawm add    quick add  (right-click)
# Running it again while that popup is open closes it.
set -euo pipefail

mode=${1:-list}
if [[ $mode == add ]]; then
    class=wangan-yawm-add title="Add task"
else
    class=wangan-yawm title="Yawm"
fi

if hyprctl clients -j | grep -q "\"class\": \"$class\""; then
    hyprctl eval 'wangan_close_popups()' >/dev/null
    exit 0
fi

exec foot \
    --app-id="$class" \
    --title="$title" \
    -o main.pad=18x14 \
    -o main.font="M PLUS 1 Code:size=11" \
    -o main.line-height=22 \
    -o colors-dark.alpha=0.94 \
    -o colors-light.alpha=0.94 \
    "$HOME/.local/bin/wangan-yawm-menu" "$mode"
