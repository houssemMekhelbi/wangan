# Taskwarrior. Shown in waybar as "yawm" (~/.local/bin/waybar-yawm):
#   click        list popup   (~/.local/bin/wangan-yawm -> wangan-yawm-menu)
#   right-click  quick add    (~/.local/bin/wangan-yawm add)
# Tasks tagged +note are notes: listed last, never counted in the bar.

data.location=~/.local/share/task
news.version=3.5.0
editor=nvim
weekstart=monday

# Wangan asa colours (256-colour approximations): overdue in redline red,
# due today in instrument amber, notes in blue.
color.due.today=bold rgb310
color.due=rgb012
color.overdue=bold rgb300
color.tag.note=rgb013
color.active=rgb013
color.header=rgb012
color.label=rgb012
color.footnote=gray10
