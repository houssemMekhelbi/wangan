# Wangan asa terminal. Night at 95%, compositor blur behind it.

font-family = M PLUS 1 Code
font-family = JetBrainsMono Nerd Font
font-size = 11
adjust-cell-height = 30%
window-padding-x = 16
window-padding-y = 16
window-decoration = none
background-opacity = 0.95
background-blur = true

background = #E4E8EE
foreground = #2A3240
cursor-color = #8F5200
cursor-text = #E4E8EE
cursor-style = block
cursor-style-blink = false
selection-background = #D5DCE7
selection-foreground = #10151D

# Search and splits in the theme's colours (ghostty's stock yellow and orange otherwise).
search-background = #1F4FA8
search-foreground = #E4E8EE
search-selected-background = #8F5200
search-selected-foreground = #E4E8EE
split-divider-color = #B7C0CD
unfocused-split-fill = #E4E8EE

palette = 0=#10151D
palette = 1=#B3161D
palette = 2=#2F6E5A
palette = 3=#8F5200
palette = 4=#1F4FA8
palette = 5=#5A3FB0
palette = 6=#1F6F82
palette = 7=#4E596B
palette = 8=#6B7587
palette = 9=#9E1219
palette = 10=#245A49
palette = 11=#7A4600
palette = 12=#17408C
palette = 13=#4A3296
palette = 14=#175C6C
palette = 15=#10151D
